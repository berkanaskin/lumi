# ============================================
# LUMI - Environment Variables Template
# v1.0.0-alpha
# ============================================

# INSTRUCTIONS:
# 1. Copy this file to .env.local
# 2. Fill in your actual API keys
# 3. NEVER commit .env.local to Git

# ========== CLIENT-SIDE SAFE (VITE_ prefix) ==========
# These keys are bundled into the client-side code
# Use only for PUBLIC, rate-limited APIs

# TMDB API Key (https://www.themoviedb.org/settings/api)
VITE_TMDB_API_KEY=your_tmdb_api_key_here

# YouTube Data API Key (https://console.cloud.google.com)
VITE_YOUTUBE_API_KEY=your_youtube_api_key_here

# OMDB API Key (http://www.omdbapi.com/apikey.aspx)
VITE_OMDB_API_KEY=your_omdb_api_key_here

# Firebase Configuration (https://console.firebase.google.com)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ========== SERVER-SIDE ONLY (NO VITE_ prefix) ==========
# These keys are NEVER exposed to the client
# They are only accessible in Vercel Functions (api/*.js)

# Gemini AI API Key (https://aistudio.google.com/app/apikey)
# ⚠️ CRITICAL: This key should NEVER be exposed to the client
GEMINI_API_KEY=your_gemini_api_key_here

# RapidAPI Key (https://rapidapi.com)
RAPIDAPI_KEY=your_rapidapi_key_here

# RevenueCat API Key (https://www.revenuecat.com)
REVENUECAT_API_KEY=your_revenuecat_api_key_here
